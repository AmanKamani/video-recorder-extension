{
  "manifest_version": 3,
  "name": "HLS Side Panel Pro",
  "version": "1.8.3",
  "description": "Record authorized HLS playback to WebM files with tab-scoped playlist scans, refresh warnings during recording, incremental disk writes, independent tab sessions, and automatic completion notifications.",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "permissions",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HLS Side Panel Pro"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
