{
  "manifest_version": 3,
  "name": "HLS Side Panel Pro",
  "version": "2.0.1",
  "description": "Record authorized HLS playback to WebM with independent tab sessions, incremental file writing, post-recording WebM duration and seek-index repair, refresh warnings, and detailed HLS diagnostics.",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "permissions",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "HLS Side Panel Pro"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}