{
  "manifest_version": 3,
  "name": "HLS Side Panel Pro",
  "version": "1.6.0",
  "description": "Detect and play HLS streams from an active website tab.",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "permissions"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HLS Side Panel Pro"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}